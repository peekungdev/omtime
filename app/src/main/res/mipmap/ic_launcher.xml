<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon for Android 6 and 7, which have no adaptive icons. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/icon_bg" />
        </shape>
    </item>
    <item
        android:bottom="-12dp"
        android:drawable="@drawable/ic_launcher_fg"
        android:left="-12dp"
        android:right="-12dp"
        android:top="-12dp" />
</layer-list>
